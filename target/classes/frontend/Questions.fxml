<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.QuestionsController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="245.0" layoutX="335.0" layoutY="-10.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../Images/NEN.png" />
         </image>
      </ImageView>
      <Label layoutX="40.0" layoutY="30.0" text="Let's personalise your schedule">
         <font>
            <Font size="18.0" />
         </font>
      </Label>
      <Label layoutX="40.0" layoutY="60.0" text="Leave any question blank to use the recommended default." textFill="#666666">
         <font>
            <Font size="11.0" />
         </font>
      </Label>

      <Label layoutX="40.0" layoutY="105.0" text="1. How many hours a day do you want to be productive?" />
      <ComboBox fx:id="cmbProductiveHours" layoutX="60.0" layoutY="128.0" prefHeight="25.0" prefWidth="120.0" promptText="1-10" />

      <Label layoutX="40.0" layoutY="180.0" text="2. Do you prefer doing quick tasks first?" />
      <RadioButton fx:id="rdbtnQuickYes" layoutX="60.0" layoutY="205.0" mnemonicParsing="false" text="Yes" />
      <RadioButton fx:id="rdbtnQuickNo" layoutX="150.0" layoutY="205.0" mnemonicParsing="false" text="No" />

      <Label layoutX="40.0" layoutY="255.0" text="3. When are you most productive?" />
      <RadioButton fx:id="rdbtnMorning" layoutX="60.0" layoutY="280.0" mnemonicParsing="false" text="Morning" />
      <RadioButton fx:id="rdbtnMidday" layoutX="170.0" layoutY="280.0" mnemonicParsing="false" text="Midday" />
      <RadioButton fx:id="rdbtnNight" layoutX="280.0" layoutY="280.0" mnemonicParsing="false" text="Night" />

      <Button fx:id="btnSaveQuestionnaire" layoutX="97.0" layoutY="360.0" mnemonicParsing="false" onAction="#onClickbtnSaveQuestionnaire" prefHeight="43.0" prefWidth="408.0" style="-fx-background-color: navy;" text="Continue" textFill="WHITE" />
   </children>
</AnchorPane>
