      </ImageView>
      <VBox layoutX="558.0" layoutY="64.0" prefHeight="171.0" prefWidth="1264.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); -fx-border-color: #eaeaea; -fx-border-radius: 12;">
         <children>
            <Label prefHeight="73.0" prefWidth="462.0" text="Set your preferences by filling in the onboarding Questionnaire" textFill="#222222" wrapText="true">
