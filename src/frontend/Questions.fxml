<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.QuestionsController">
   <children>
      <ImageView fitHeight="100.0" preserveRatio="true" AnchorPane.leftAnchor="40.0" AnchorPane.topAnchor="20.0">
         <image>
            <Image url="@../Images/NEN.png" />
         </image>
      </ImageView>
      
      <!-- Central Wrapper ensures the card stays centered and shrinks if needed -->
      <StackPane AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            
            <VBox alignment="CENTER_LEFT" maxWidth="850.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-padding: 50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 10);">
               <StackPane.margin>
                  <Insets bottom="40.0" top="80.0" />
               </StackPane.margin>
               <children>
                  <VBox spacing="10.0">
                     <children>
                        <Label text="Set Your Preferences" textFill="#1e293b">
                           <font><Font name="System Bold" size="28.0" /></font>
                        </Label>
                        <Label text="Leave any question blank to use the recommended default." textFill="#64748b">
                           <font><Font size="16.0" /></font>
                        </Label>
                     </children>
                     <VBox.margin>
                        <Insets bottom="20.0" />
                     </VBox.margin>
                  </VBox>

                  <!-- Question 1 -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="1. How many hours a day do you want to be productive?" textFill="#334155">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbProductiveHours" prefHeight="40.0" prefWidth="150.0" promptText="1-10" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
                     </children>
                  </VBox>

                  <!-- Question 2 -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="2. Do you prefer doing quick tasks first?" textFill="#334155">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <HBox spacing="30.0">
                           <children>
                              <RadioButton fx:id="rdbtnQuickYes" mnemonicParsing="false" text="Yes" textFill="#475569"><font><Font size="16.0" /></font></RadioButton>
                              <RadioButton fx:id="rdbtnQuickNo" mnemonicParsing="false" text="No" textFill="#475569"><font><Font size="16.0" /></font></RadioButton>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Question 3 -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="3. When are you most productive?" textFill="#334155">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <HBox spacing="30.0">
                           <children>
                              <RadioButton fx:id="rdbtnMorning" mnemonicParsing="false" text="Morning" textFill="#475569"><font><Font size="16.0" /></font></RadioButton>
                              <RadioButton fx:id="rdbtnMidday" mnemonicParsing="false" text="Midday" textFill="#475569"><font><Font size="16.0" /></font></RadioButton>
                              <RadioButton fx:id="rdbtnNight" mnemonicParsing="false" text="Night" textFill="#475569"><font><Font size="16.0" /></font></RadioButton>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                     
                  <!-- Question 4 -->
                  <VBox spacing="10.0">
                     <children>
                        <Label text="4. Working Window (HH:mm)" textFill="#334155">
                           <font><Font name="System Bold" size="18.0" /></font>
                        </Label>
                        <HBox spacing="30.0">
                           <children>
                              <TextField fx:id="txtPrefStartTime" prefHeight="40.0" prefWidth="150.0" promptText="Start (07:00)" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
                              <TextField fx:id="txtPrefEndTime" prefHeight="40.0" prefWidth="150.0" promptText="End (22:00)" style="-fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <!-- Save Button -->
                  <Button fx:id="btnSaveQuestionnaire" maxWidth="1000.0" mnemonicParsing="false" onAction="#onClickbtnSaveQuestionnaire" prefHeight="55.0" style="-fx-background-color: #0f172a; -fx-background-radius: 8; -fx-cursor: hand;" text="Set Preferences" textFill="WHITE" VBox.vgrow="ALWAYS">
                     <font><Font name="System Bold" size="18.0" /></font>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</AnchorPane>