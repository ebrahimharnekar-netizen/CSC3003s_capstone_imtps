            </ImageView>
            
            <HBox alignment="CENTER_LEFT" prefHeight="90.0" spacing="15.0" style="-fx-background-color: #f8f9fa; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15; -fx-padding: 0 20 0 20;" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="20.0">
