<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: navy;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.HelpController">
   <children>
      
      <!-- Scrollable content centered -->
      <ScrollPane fitToHeight="true" fitToWidth="true" layoutX="0.0" layoutY="0.0" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background: navy; -fx-background-color: transparent;">
         <content>
            <StackPane>
               <children>
                  <VBox alignment="TOP_CENTER" maxWidth="1000.0" prefWidth="1000.0" spacing="25.0" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 20, 0, 0, 5);">
                     <StackPane.margin>
                        <Insets bottom="40.0" top="40.0" />
                     </StackPane.margin>
                     <children>
                        
                        <!-- Logo -->
                        <ImageView fitHeight="226.0" fitWidth="452.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../Images/NEN.png" />
                           </image>
                        </ImageView>
                        
                        <!-- Quick overview -->
                        <Label alignment="CENTER" prefHeight="43.0" prefWidth="900.0" style="-fx-font-weight: bold; -fx-text-fill: #37474f;" text="Below explains all the different terminology and rules needed to use NEN" textAlignment="CENTER">
                           <font>
                              <Font size="26.0" />
                           </font>
                        </Label>
                        <Label alignment="CENTER" maxWidth="800.0" prefHeight="60.0" style="-fx-text-fill: #546e7a;" text="This app automatically schedules your tasks, respecting fixed appointments you set. Use the tabs below to add, view, or edit tasks." textAlignment="CENTER" wrapText="true">
                           <font>
                              <Font size="16.0" />
                           </font>
                        </Label>
                        
                        <!-- Pinned vs Floating -->
                        <VBox maxWidth="900.0" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #e0e0e0; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #37474f;" text="📌 Pinned vs Floating Tasks" />
                              <Label maxWidth="850.0" style="-fx-font-size: 15px; -fx-text-fill: #455a64; -fx-line-spacing: 5px;" text="• Pinned – have a start date AND start time. They are fixed and never moved.&#10;• Floating – have no start time. They are automatically scheduled when you click Refresh." wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Focus Modes -->
                        <VBox maxWidth="900.0" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #90caf9; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;" text="🎯 Focus Modes" />
                              <Label maxWidth="850.0" style="-fx-font-size: 15px; -fx-text-fill: #0d47a1; -fx-line-spacing: 5px;" text="Choose Work, Health, or Personal in the View tab. Tasks from the selected category get priority and are scheduled earlier in the day." wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Scheduling Algorithms -->
                        <VBox maxWidth="900.0" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #a5d6a7; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;" text="⚙️ How Scheduling Works" />
                              <Label maxWidth="850.0" style="-fx-font-size: 15px; -fx-text-fill: #1b5e20; -fx-line-spacing: 5px;" text="• Priority Scheduler (Work mode) – scores tasks by importance, urgency, category match, and duration.&#10;• Deadline Scheduler (Health/Personal) – schedules tasks by earliest due date first.&#10;• Both algorithms respect pinned tasks and schedule within the day (7 AM – 10 PM)." wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Quick Guide -->
                        <VBox maxWidth="900.0" spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 20; -fx-border-color: #ffcc80; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e65100;" text="📋 Quick Guide" />
                              <Label maxWidth="850.0" style="-fx-font-size: 15px; -fx-text-fill: #e65100; -fx-line-spacing: 5px;" text="• Add – fill in task details; leave Start Time blank to make it floating.&#10;• View – select a date, choose a focus mode, then click Refresh to schedule/update.&#10;• Edit – search for a task, change any field, and save.&#10;• To delete – check the box next to a task in View and click Refresh." wrapText="true" />
                           </children>
                        </VBox>
                        
                        <!-- Important Note -->
                        <VBox maxWidth="900.0" spacing="10.0" style="-fx-background-color: #fce4ec; -fx-padding: 20; -fx-border-color: #ef9a9a; -fx-border-radius: 12; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                           <children>
                              <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #b71c1c;" text="⚠️ Important" />
                              <Label maxWidth="850.0" style="-fx-font-size: 15px; -fx-text-fill: #b71c1c; -fx-line-spacing: 5px;" text="Floating tasks are never saved with a start time. Each Refresh recomputes the schedule, so you always get the best possible arrangement based on your current focus mode." wrapText="true" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </StackPane>
         </content>
      </ScrollPane>

      <!-- Floating Back Button -->
      <Button fx:id="btnBack" layoutX="30.0" layoutY="30.0" mnemonicParsing="false" onAction="#onClickbtnBack" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #cccccc; -fx-border-radius: 8;" text="&lt; Back">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      
   </children>
</AnchorPane>