<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="650.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="frontend.HelpController">
   <children>
      
      <!-- Scrollable content -->
      <ScrollPane fitToWidth="true" layoutX="-1.0" prefHeight="447.0" prefWidth="650.0" style="-fx-background: white; -fx-background-color: white;">
         <content>
            <VBox prefWidth="635.0" spacing="15" style="-fx-padding: 20; -fx-background-color: white;">
               <children>
                  <ImageView fitHeight="117.0" fitWidth="192.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../Images/NEN.png" />
                     </image>
                  </ImageView>
                  <!-- Quick overview -->
                  <Label prefHeight="26.0" prefWidth="190.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #37474f;" text="Welcome to NEN">Welcome to IMTPS</Label>
                  <Label maxWidth="600" prefHeight="40.0" prefWidth="503.0" style="-fx-font-size: 14px; -fx-text-fill: #546e7a;" wrapText="true">
                     This app automatically schedules your tasks, respecting fixed appointments you set. 
                     Use the tabs below to add, view, or edit tasks.
                  </Label>
                  
                                    <!-- Pinned vs Floating -->
                  <VBox spacing="5" style="-fx-background-color: #f5f5f5; -fx-padding: 12; -fx-border-color: #e0e0e0; -fx-border-radius: 5; -fx-background-radius: 5;">
                     <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #37474f;">📌 Pinned vs Floating Tasks</Label>
                     <Label maxWidth="580" style="-fx-font-size: 13px; -fx-text-fill: #455a64;" wrapText="true">
                        • Pinned – have a start date AND start time. They are fixed and never moved.
                        • Floating – have no start time. They are automatically scheduled when you click Refresh.
                     </Label>
                  </VBox>
                  
                                    <!-- Focus Modes -->
                  <VBox spacing="5" style="-fx-background-color: #e3f2fd; -fx-padding: 12; -fx-border-color: #90caf9; -fx-border-radius: 5; -fx-background-radius: 5;">
                     <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0d47a1;">🎯 Focus Modes</Label>
                     <Label maxWidth="580" style="-fx-font-size: 13px; -fx-text-fill: #0d47a1;" wrapText="true">
                        Choose Work, Health, or Personal in the View tab. 
                        Tasks from the selected category get priority and are scheduled earlier in the day.
                     </Label>
                  </VBox>
                  
                                    <!-- Scheduling Algorithms -->
                  <VBox spacing="5" style="-fx-background-color: #e8f5e9; -fx-padding: 12; -fx-border-color: #a5d6a7; -fx-border-radius: 5; -fx-background-radius: 5;">
                     <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1b5e20;">⚙️ How Scheduling Works</Label>
                     <Label maxWidth="580" style="-fx-font-size: 13px; -fx-text-fill: #1b5e20;" wrapText="true">
                        • Priority Scheduler (Work mode) – scores tasks by importance, urgency, category match, and duration.
                        • Deadline Scheduler (Health/Personal) – schedules tasks by earliest due date first.
                        • Both algorithms respect pinned tasks and schedule within the day (7 AM – 10 PM).
                     </Label>
                  </VBox>
                  
                                    <!-- Quick Guide -->
                  <VBox spacing="5" style="-fx-background-color: #fff3e0; -fx-padding: 12; -fx-border-color: #ffcc80; -fx-border-radius: 5; -fx-background-radius: 5;">
                     <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #e65100;">📋 Quick Guide</Label>
                     <Label maxWidth="580" style="-fx-font-size: 13px; -fx-text-fill: #e65100;" wrapText="true">
                        • Add – fill in task details; leave Start Time blank to make it floating.
                        • View – select a date, choose a focus mode, then click Refresh to schedule/update.
                        • Edit – search for a task, change any field, and save.
                        • To delete – check the box next to a task in View and click Refresh.
                     </Label>
                  </VBox>
                  
                                    <!-- Important Note -->
                  <VBox spacing="5" style="-fx-background-color: #fce4ec; -fx-padding: 12; -fx-border-color: #ef9a9a; -fx-border-radius: 5; -fx-background-radius: 5;">
                     <Label style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #b71c1c;">⚠️ Important</Label>
                     <Label maxWidth="580" style="-fx-font-size: 13px; -fx-text-fill: #b71c1c;" wrapText="true">
                        Floating tasks are never saved with a start time. Each Refresh recomputes the schedule, 
                        so you always get the best possible arrangement based on your current focus mode.
                     </Label>
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
      
      <!-- Bottom Bar with Back Button -->
      <AnchorPane layoutY="450.0" prefHeight="50.0" prefWidth="650.0" style="-fx-background-color: lightgrey;">
         <children>
            <Button fx:id="btnBack" layoutX="14.0" layoutY="4.0" mnemonicParsing="false" onAction="#onClickbtnBack" prefHeight="35.0" prefWidth="84.0" text="Back" />
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
